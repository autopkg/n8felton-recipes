<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest version of jamovi.

ARCH selects the architecture:
- macos-arm64 (default): Apple Silicon
- macos-x64: Intel
CHANNEL selects the release track:
- solid (default): the tried and tested release jamovi recommends
- current: the newest features, ahead of solid
- legacy: the previous long-term release
</string>
	<key>Identifier</key>
	<string>com.github.n8felton.download.jamovi</string>
	<key>Input</key>
	<dict>
		<key>ARCH</key>
		<string>macos-arm64</string>
		<key>CHANNEL</key>
		<string>solid</string>
		<key>NAME</key>
		<string>jamovi</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.9.0</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>keys</key>
				<dict>
					<key>version</key>
					<string>macos.%CHANNEL%</string>
				</dict>
				<key>url</key>
				<string>https://www.jamovi.org/versions.json</string>
			</dict>
			<key>Processor</key>
			<string>com.github.n8felton.shared/JSONURLGetter</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>%NAME%-%version%-%ARCH%.dmg</string>
				<key>request_headers</key>
				<key>url</key>
				<string>https://dl-cdn.jamovi.org/%NAME%-%version%-%ARCH%.dmg</string>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%/jamovi.app</string>
				<key>requirement</key>
				<string>identifier "org.jamovi.jamovi" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "9NCBP559AB"</string>
			</dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
		</dict>
	</array>
</dict>
</plist>
